DATABASE_URL=postgresql://postgres:changeme@localhost:5432/jobs
# Managed Postgres (RDS, etc.) requires SSL — leave unset/false for local Docker Postgres.
DATABASE_SSL=false
# Optional — defaults to 10, a sane starting point for a single small API instance.
DATABASE_POOL_MAX=10
PORT=5000

# Postgres (self-hosted via Docker) — keep these two in sync, the second is
# the URL-encoded form used inside connection strings
POSTGRES_PASSWORD=changeme
POSTGRES_PASSWORD_URLENCODED=changeme

# SuperTokens (self-hosted via Docker)
SUPERTOKENS_URL=http://localhost:43567
SUPERTOKENS_API_KEY=generate-a-random-string-and-put-it-here

# Domains — update WEBSITE_DOMAIN to your frontend's actual dev URL
API_DOMAIN=http://localhost:5000
WEBSITE_DOMAIN=http://localhost:5173
APP_DOMAIN=http://localhost:8081

# MinIO (object storage via Docker)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too
MINIO_PUBLIC_BUCKET=cuban-jobs-public
MINIO_PRIVATE_BUCKET=cuban-jobs-private
MINIO_PUBLIC_URL=http://localhost:9000
# Required outside us-east-1 when pointed at real AWS S3; unused by self-hosted MinIO.
MINIO_REGION=

# Redis (self-hosted via Docker) — backs the BullMQ notification queue
REDIS_URL=redis://localhost:46379

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Stripe is hidden for now: set STRIPE_ENABLED=true to turn on the checkout/portal endpoints.
STRIPE_ENABLED=false
# Stripe (billing) — test-mode keys/prices for dev, live-mode for prod, never mixed.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...

# Only read by `npm run seed` — never needed outside local/dev seeding.
SEED_EMPLOYER_EMAIL=employer@example.com
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_PASSWORD=changeme123
